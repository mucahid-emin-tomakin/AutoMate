{
  "manifest_version": 3,
  "name": "DeepForge",
  "version": "1.0.0",
  "description": "DeepSeek-Chats as JSON, Markdown, HTML or Text exporter, by TomaKing.",
  "homepage_url": "https://mucahid-emin-tomakin.vercel.app/",
  "permissions": ["storage"],
  "host_permissions": [
      "https://chat.deepseek.com/*",
      "https://*.deepseek.com/*" ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"},
    "default_title": "DeepForge"},
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"},
  "content_scripts": [{
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle" }],
  "background": {"service_worker": "background.js"},
  "web_accessible_resources": [{
      "resources": ["styles.css", "fonts/*"],
      "matches": ["https://chat.deepseek.com/*"] }]
}